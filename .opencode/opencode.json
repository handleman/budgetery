{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "model": "anthropic/claude-3-5-sonnet-20241022",
      "description": "Build and compile the app",
      "mode": "primary"
    }
  },
  "agent": {
    "test-guardian": {
      "model": "anthropic/claude-3-5-sonnet-20241022", 
      "description": "Guard against rewriting files that are covered by unit tests",
      "mode": "subagent",
      "permission": {
        "edit": "ask"
      }
    }
  }
}
