{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "model": "anthropic/claude-3-5-sonnet-20241022",
      "description": "Build and compile the app",
      "mode": "primary"
    },
"test-guardian": {
      "model": "anthropic/claude-3-5-sonnet-20241022",
      "description": "Guard against rewriting source files during unit test writing. Auto-detects .test.ts paired sources and asks permission before blocking edits.",
      "mode": "subagent",
      "auto-scan": true,
      "detectors": [
        {
          "type": "file-pattern",
          "pattern": "**/*.{ts,tsx,js,jsx}",
          "paired_test": "**/*.test.ts",
          "scanDirectories": ["app", "hooks", "components", "store"],
          "exclusions": []
        }
      ],
      "rules": [
        {
          "trigger": "conversation mentions unit tests + file detected",
          "action": "ask_permission_then_block",
          "scope": "${detected_source_files}",
          "exclusions": []
        }
      ],
      "permission": {
        "edit": "ask"
      }
    },
  "plugin": [
    "opencode-browser"
  ]
}
